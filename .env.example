AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000

# Use a dedicated Google connection; don't expand a shared demo's permissions.
AUTH0_GOOGLE_CONNECTION=google-oauth2
# Optional: pin Universal Login to a particular enabled connection.
# AUTH0_LOGIN_CONNECTION=Username-Password-Authentication

# Optional: configure the Auth0 hosted event review before setting this audience.
# AUTH0_CIBA_REVIEW_AUDIENCE=https://your-api.example.com/ciba-calendar-review
